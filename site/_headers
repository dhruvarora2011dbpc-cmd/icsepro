/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # Only used by Cloudflare Pages / Netlify (GitHub Pages ignores this file).
  # Replace YOUR-WORKER.workers.dev with your AI proxy address.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://YOUR-WORKER.workers.dev; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
